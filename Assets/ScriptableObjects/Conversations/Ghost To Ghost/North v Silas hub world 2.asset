  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Silas hub world 2
  m_EditorClassIdentifier: 
  data:
    convoName: North v Silas hub world 2
    speakers:
    - North
    - Silas
    lines:
    - character: Silas
      expression: 
      line: 'Good evening, madam. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Evening. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Forgive my asking, but are those scars of chicken pox? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Yeah, a wave of it swept through the city when I was about 10. What\u2019s
        it to you? "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "I\u2019m merely surprised it\u2019s still prevalent, even so distant
        in the future. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Yeah, even with all our fancy drugs and nanomachines, people are still
        dying every day. Some things just slip through the cracks\u2026 lotta things,
        really. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "No, I meant that I\u2019d already formulated a comprehensive cure during
        my time alive. It appears that some of my research has died with me. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Huh. You old-timers really had some tricks, didn\u2019t you?"
      audio: {fileID: 0}
