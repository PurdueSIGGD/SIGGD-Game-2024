  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Yume hub world
  m_EditorClassIdentifier: 
  data:
    convoName: North v Yume hub world
    speakers:
    - North
    - Yume
    lines:
    - character: North
      expression: 
      line: "So these guys are supposed to be saving the world. What\u2019s a little
        thing like you doing here? "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Moral support. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Yeah, right! '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "You don\u2019t believe me? "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "To be fair, you don\u2019t seem like much of a fighter. "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Of course. What would a harmless little seamstress know about fighting? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "\u2026I can\u2019t tell if you\u2019re being serious or not."
      audio: {fileID: 0}
