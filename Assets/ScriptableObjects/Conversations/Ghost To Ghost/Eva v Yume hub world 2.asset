  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Yume hub world 2
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Yume hub world 2
    speakers:
    - Eva
    - Yume
    lines:
    - character: Eva
      expression: 
      line: 'So you know the Samurai, right? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Somewhat; we were in the same clan. I only heard passing rumors about
        them. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'Really? But you aren''t like them at all. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'What makes us so different? / How so? '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "They\u2019re all sad and angry all the time. "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "I don\u2019t really blame them, being born in the Kanazawa clan and
        all."
      audio: {fileID: 0}
