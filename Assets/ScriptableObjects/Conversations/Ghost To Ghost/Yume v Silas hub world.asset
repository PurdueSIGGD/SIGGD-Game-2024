  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Yume v Silas hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Yume v Silas hub world
    speakers:
    - Yume
    - Silas
    lines:
    - character: Silas
      expression: 
      line: 'Say, do you sew all your own clothing? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "That\u2019s right. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "Well, I must say, you have an extraordinary talent. You know, where
        I\u2019m from, pity few would even dream of wearing patterns like this. "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Oh\u2026 thank you! It\u2019s a hobby I\u2019ve had for a long time.
        It\u2019s nice to have something to do with your hands. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: I know the feeling.
      audio: {fileID: 0}
