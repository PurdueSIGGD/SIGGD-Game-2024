  m_Name: Yume v Silas first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Yume v Silas first meeting
    speakers:
    - Yume
    - Silas
    lines:
    - character: Silas
      expression: 
      line: 'Yume, was it? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Mm-hm. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Doctor Silas, at your service. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "You\u2019re a doctor? I\u2019ve never seen a doctor dressed like that
        before\u2026 "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "You mean to tell me this mask falls out of fashion in the future? Well,
        I\u2019ll be... "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Don\u2019t worry, if you ever want new clothes, just ask!"
      audio: {fileID: 0}
