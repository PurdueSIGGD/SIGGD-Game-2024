    lines:
    - character: Eva
      expression: 
      line: 'So you were part of a group? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "A clan. But\u2026 yes. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Do you\u2026 miss it? "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Always. Do you miss your company? '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: Never.
      audio: {fileID: 0}
