--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Akihito v Silas hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Akihito v Silas hub world
    speakers:
    - Akihito
    - Silas
    lines:
    - character: Akihito
      expression: 
      line: 'Silas. You are a medicine man. You have a potion that can make one forget? '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Anything to cure what ails you, my friend! What has you down? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "\u2026 "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "Well, no matter. I can offer tonics for any occasion. Here\u2026a powerful
        neuroleptic. I\u2019ve brewed it just for your sake. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'This will ease my burden? '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Yes, indeed! I might also recommend a supplementary sequestrant; you
        seem to have a dyscrasia of black bile. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "Thank you, but\u2013 "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "And for your melancholic temperament, perhaps some \u2026 now, where
        was it? Yes, I\u2019ve got it \u2013 a tincture of spleenwort! "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "Silas, I cannot accept such\u2013 "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'And some sedatives, of course. Take one twice daily. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "\u2026 I humbly accept your generosity. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Good man! Now then, is there anything still the matter? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "Your\u2026 craft differs from the remedies of my country. These medicines
        are unknown to me. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "I\u2019d be surprised if they weren\u2019t! They\u2019re all of my own
        invention. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "Ah \u2026 well, I suppose I\u2019ve already accepted them, haven\u2019t
        I? "
      audio: {fileID: 0}
