MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Aegis first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Aegis first meeting
    speakers:
    - Eva
    - Aegis
    lines:
    - character: King Aegis
      expression: 
      line: 'Pardon me, miss, do you have a metallic body? '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "I do! I am\u2026 was about 98 percent inorganic. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Ehm\u2026 I see... If you don\u2019t mind me asking, are you\u2026 human? "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "You know, that\u2019s a good question\u2026 I don\u2019t have a living
        cell in my body, except in my brain. By all accounts, my own awareness could
        be keeping the full picture out of my sight, but all the divine rules of
        life and death have somehow also applied to me. After all, I\u2019m here
        talking to you now as a ghost. So is it the body or the soul that truly makes
        us human? "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "\u2026 "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Anyway, do you think I could try on your crown? It\u2019s soooo shiny!!"
      audio: {fileID: 0}
