--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Yume v Aegis first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Yume v Aegis first meeting
    speakers:
    - Yume
    - Aegis
    lines:
    - character: Yume
      expression: 
      line: "Uh, hello, my name is Yume\u2026 your majesty?  "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "You don\u2019t have to call me majesty. After all, I don\u2019t have
        a kingdom to rule anymore.  "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Oh\u2026 So how was it being king? You ruled over everyone and had no
        one to answer to. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "That\u2019s one way to look at it. However, I felt that I answered to
        my people. Their wants and needs were always my top priority. "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "You sound like you were a great leader! The heads of my clan didn\u2019t
        really care about their people at all, especially not the little girl they
        made sew their clothes. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Well, despite the terrible circumstances we are meeting in, I\u2019m
        glad you are away from that life. "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: Honestly, me too.
      audio: {fileID: 0}
