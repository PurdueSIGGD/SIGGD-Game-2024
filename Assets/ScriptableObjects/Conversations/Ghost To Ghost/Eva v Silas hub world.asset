MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Silas hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Silas hub world
    speakers:
    - Eva
    - Silas
    lines:
    - character: Eva
      expression: 
      line: "So, what\u2019s your story? "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "Oh, my position was a respectable one\u2026 but I never did it for the
        glory. I traveled, I studied, I made alchemic breakthroughs! And when the
        plague fell on my kingdom, I fought like Saint Ivan to fend it off! "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Whoa, cool! You\u2019re like a superhero! "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "I certainly was. But, then\u2026 I died. I failed my people. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Well, that\u2019s no attitude. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "I know, I know. Sometimes it\u2019s just hard not to put the blame on
        myself. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Listen, Mister doctor, you didn\u2019t fail anyone! You know why? Because
        you never gave up. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Well, I must say, you really know how to cheer a man up. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: All part of the job!
      audio: {fileID: 0}
