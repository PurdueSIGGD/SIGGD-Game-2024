MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v North hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v North hub world
    speakers:
    - Eva
    - North
    lines:
    - character: Eva
      expression: 
      line: 'Hi Chief North! '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'What do you want, Eva? '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'Snappy, huh? I just wanted to ask what you liked about being a police
        chief. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'I liked helping people.  '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Helping people? Didn\u2019t seem like you were doing much of that, trying
        to capture me and all. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "I said people, not bots like you. And trying to capture you was how
        I was helping people. Getting rid of you and your lab-brained lot would\u2019ve
        shown Nova Point just how reckless technology is. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'How would destroying us robots benefit the city? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "I would\u2019ve been able to protect my people the way I knew they needed. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Ahhh, so you like controlling people. That\u2019s all I was looking
        for, ya know. I didn\u2019t need your whole backstory. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: Damn clankers.
      audio: {fileID: 0}
