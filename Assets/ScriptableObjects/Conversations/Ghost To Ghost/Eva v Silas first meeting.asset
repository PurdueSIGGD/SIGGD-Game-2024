  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Silas first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Silas first meeting
    speakers:
    - Eva
    - Silas
    lines:
    - character: Eva
      expression: 
      line: 'Oh wow, I love your bird mask! '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "Why, thank you, lass. Your outfit\u2019s not too shabby either. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'Thanks! '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "So\u2026 is it true that the plague is a distant memory in the future? "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "As far as I know. Biggest thing I\u2019ve got to worry about is what
        I\u2019m gonna wear on stage next! "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "On stage? So you\u2019re a performer? "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "That\u2019s right! I\u2019ve got a mission: to fight corruption and
        bring joy to the people of the world through song. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: A noble cause, much like my own. The passion of youth truly is incredible.
      audio: {fileID: 0}
