%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Yume v Aegis hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Yume v Aegis hub world
    speakers:
    - Yume
    - Aegis
    lines:
    - character: Yume
      expression: 
      line: "And I can travel / Anywhere I want to now\u2026 / And get rich as well. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Did you say that in a meter? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Yeah! I\u2019ve been trying to do some poetry now and then, and I heard
        you enjoy it! This kind is from my land, it\u2019s called a haiku. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Fascinating! How does it work? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Haikus are three lines, where the first and the third are supposed to
        be 5 syllables, and the middle line 7. I struggle sometimes to get the right
        words for the syllables I need, but it\u2019s fun! "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Hmmm. So \u2013 This line will have 5 / Now this line has 7 beats /
        and lastly 5 more "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Yeah! Not bad for a start / Perhaps a little spark then / Could make
        it have heart.  '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "I suppose I\u2019ll have to keep practicing! "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: You and me both!
      audio: {fileID: 0}
