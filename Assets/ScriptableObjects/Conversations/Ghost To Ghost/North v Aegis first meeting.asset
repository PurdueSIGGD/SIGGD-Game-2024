  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Aegis first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: North v Aegis first meeting
    speakers:
    - North
    - Aegis
    lines:
    - character: North
      expression: 
      line: 'A king? Who are you? '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'That I am. King Aegis of Caladria. Pleasure to meet you. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'You as well. What was your kingdom like? '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Oh, it was beautiful. However, it is going through\u2026 unfortunate
        times. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "You don\u2019t say. What happened? "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'A plague. And a dragon. A plague dragon, actually. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "And where\u2019d it come from? "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "So he hasn\u2019t told you? I expected as much\u2026"
      audio: {fileID: 0}
