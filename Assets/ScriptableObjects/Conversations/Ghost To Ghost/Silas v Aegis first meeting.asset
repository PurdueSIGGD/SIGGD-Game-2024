--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Silas v Aegis first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Silas v Aegis first meeting
    speakers:
    - Silas
    - Aegis
    lines:
    - character: Silas
      expression: 
      line: 'My liege! What great luck that our paths should cross again, even in
        death. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Our favorite palace doctor, met once more! / A trusted face is water
        in a drought. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Or medicine to a sick man, perhaps. I toil to heal this land, even beyond
        my dying breath. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'If only we had kept the sword held fast, / Perhaps your fate might not
        have been so grim. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "As a matter of fact, Your Majesty, I don\u2019t find existence as a
        spirit so disagreeable. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'No? '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Indeed. My cloak can no longer be stained; the blood just falls through! '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "You always did manage to find the positive in everything, Silas\u2026"
      audio: {fileID: 0}
