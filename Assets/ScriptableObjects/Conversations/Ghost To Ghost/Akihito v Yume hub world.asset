MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Akihito v Yume hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Akihito v Yume hub world
    speakers:
    - Akihito
    - Yume
    lines:
    - character: Akihito
      expression: 
      line: 'You were rather young when you started sewing, yes? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Yeah, I was. And you were pretty old when you started sword-ing? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'I was 14. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Yeah\u2026 Old. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "Well, I can\u2019t imagine what my life would have been like if I never
        left the clan. How was it staying with them all that time? "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "I don\u2019t know\u2026 They gave me shelter and all, but\u2026 I wasn\u2019t
        really happy. At the time, I heard stories of how you \u2018abandoned the
        family,\u2019 and I hated you for it. But now I see I should\u2019ve been
        jealous. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "The outside world wasn\u2019t all great, but it was certainly better
        than supporting the corruption in the clan. "
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Hey, that wasn\u2019t my fault! "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'All I''m saying is I stopped helping them '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Yeah, well, uhhh \u2026. Whatever!"
      audio: {fileID: 0}
