  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Aegis hub world 1
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Aegis hub world 1
    speakers:
    - Eva
    - Aegis
    lines:
    - character: Eva
      expression: 
      line: 'So you alone rule everyone? '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Well not everyone, just the people within my kingdom. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'And you''re not bad, are you? '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "I don't think so\u2026. then again, how do we truly tell the difference
        between good and bad? "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "\u2026is my outfit cute? "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Very\u2013 though we could ask the seamstress to add some lace to the
        bottom hem. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: You're definitely good!
      audio: {fileID: 0}
