  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v North first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Chief first meeting
    speakers:
    - Eva
    - North
    lines:
    - character: North
      expression: 
      line: 'EVA! '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Hi! I\u2019m Eva. What\u2019s your name? "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "I can\u2019t believe you died before I could kill you. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'Well, I died anyways! '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "I spent years trying to capture you, but I kept failing. I suppose that\u2019s
        why Orion chose you as a companion. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Oh! You\u2019re the police chief! You were very good at your job. I
        had a hard time trying to escape you and your crew. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Chief North, and that was the point. Except you weren\u2019t supposed
        to escape. "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'You almost got me a couple times! '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: Ugh.
      audio: {fileID: 0}
