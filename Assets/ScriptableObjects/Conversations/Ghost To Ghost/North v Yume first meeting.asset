  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Yume first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: North v Yume first meeting
    speakers:
    - North
    - Yume
    lines:
    - character: North
      expression: 
      line: 'Hey, Princess! Careful not to trip on those robes. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Are you talking to me? I tailored this myself, for your information. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Woah, sassy. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Look at the way you dress before you talk to me please. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'This is the standard uniform for all officers in Nova Point. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'I guess fashion went out of style. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "I guess kids are brats\u2026 regardless of time."
      audio: {fileID: 0}
