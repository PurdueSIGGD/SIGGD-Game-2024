--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Akihito v Silas first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Akihito v Silas first meeting
    speakers:
    - Akihito
    - Silas
    lines:
    - character: Silas
      expression: 
      line: "Tell me, is it true that samurai are capable of superhuman physical
        endurance? I\u2019ve heard of a warrior who stood and fought for three days
        and nights to protect his lord. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "That old tale\u2026 "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'I am afraid it is just a fable. Nothing more. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'A shame. I had some experiments I was eager to try. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Experiments? '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Indeed! For example, is wormwood an effective antidote for nightshade? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "What if it isn\u2019t? "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "Well, that\u2019s why I need a test subject with a strong constitution. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "\u2026"
      audio: {fileID: 0}
