  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Akihito first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Akihito first meeting
    speakers:
    - Eva
    - Akihito
    lines:
    - character: Akihito
      expression: 
      line: 'A performer? As a samurai, a fellow appreciator of the arts is always
        welcome. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: "Yep! I\u2019m a singer, songwriter, and dancing extraordinaire!  "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Impressive. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'What do you do as a samurai, friend? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Deliver justice to those unredeeming with my blade. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'OH COOL! '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "\u2026and paint in my free time "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: OH SUPER COOL!
      audio: {fileID: 0}
