  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Akihito v Yume first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Akihito v Yume
    speakers:
    - Akihito
    - Yume
    lines:
    - character: Akihito
      expression: 
      line: 'Ah, the talented seamstress. I did not think we would ever get to meet. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "I didn\u2019t think the \u2018cowardly\u2019 ronin they spoke of would
        ever return. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'I did. I was just too late. '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "You don\u2019t seem cowardly to me. You left and got to explore the
        world. How was that? That was something I wish I got to do. "
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "It was beautiful. Something you\u2019ll see for yourself. "
      audio: {fileID: 0}
