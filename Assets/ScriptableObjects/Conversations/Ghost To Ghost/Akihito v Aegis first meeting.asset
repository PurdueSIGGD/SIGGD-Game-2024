MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Akihito v Aegis first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Akihito v Aegis first meeting
    speakers:
    - Akihito
    - Aegis
    lines:
    - character: Akihito
      expression: 
      line: "Hmmm, so you were the emperor of your land? Then perhaps you can enlighten
        me about some of your territory\u2019s sword techniques. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "I\u2019m afraid not. I consider myself to be more of a creative."
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Poetry was my calling. I recall overhearing you talking about the abundance
        of poetry in your land, was that correct? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'For a samurai, it is a part of our discipline. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Oh, really? I would love to hear your work sometime. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Perhaps, although it was never something I excelled at. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "That\u2019s nonsense!"
      audio: {fileID: 0}
