--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Aegis hub world
  m_EditorClassIdentifier: 
  data:
    convoName: North v Aegis hub world
    speakers:
    - North
    - Aegis
    lines:
    - character: King Aegis
      expression: 
      line: "So I hear you\u2019re a knight. However, you seem to be without much
        protection for someone sworn to protect your people. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Knight? No. I\u2019m a police officer. I protect people from criminals,
        not dragons and goblins. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "And what is it you do to these\u2026 \u201Ccriminals\u201D? As punishment? "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'I put them where they belong. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Slain \u2026 exiled? "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Not usually, no. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'What about the rumored mechanical people in your time? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Those clankers? UGH. They\u2019re taken apart or factory reset. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "\u2026Pardon? "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Dismembered or lobotomized. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'Lobotomized?! Oh, my. That seems excessive. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: They deserve it.
      audio: {fileID: 0}
