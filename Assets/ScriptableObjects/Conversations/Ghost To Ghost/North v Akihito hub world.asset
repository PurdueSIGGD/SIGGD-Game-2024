  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Akihito hub world
  m_EditorClassIdentifier: 
  data:
    convoName: North v Akihito hub world
    speakers:
    - North
    - Akihito
    lines:
    - character: North
      expression: 
      line: 'So what type of enhancements do you have? They look very natural. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: "Enhancements? Is that your people\u2019s word for training? "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Training? No I mean extra stuff you added to your body, like cyborgs. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'I have never heard of cyborgs before and I have only ever changed my
        body through brutal training. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "It\u2019s nice to meet someone with natural skill."
      audio: {fileID: 0}
