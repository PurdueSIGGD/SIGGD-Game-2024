--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Akihito first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: North v Akihito first meeting
    speakers:
    - North
    - Akihito
    lines:
    - character: North
      expression: 
      line: 'Your sword caught my attention, are you an actual samurai? I used to
        watch them in movies all the time. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'I am. My name is Akihito, of the Kanazawa Clan. And you? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'Chief North. Of Nova Point. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Chief? Whom did you oversee? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'I was a part of the police. We worked to protect innocents and stop
        criminals wherever they cropped up. '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'Ah, that was my role as well. I was a samurai, as you mentioned, who
        saved as many as I could with my sword. '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'The sword was enough for you? What about enemies at a range? '
      audio: {fileID: 0}
    - character: Akihito
      expression: 
      line: 'I am also quite adept at the bow, although I would never let myself
        be caught at a disadvantageous range. How did you deal with foes close to
        you? '
      audio: {fileID: 0}
    - character: North
      expression: 
      line: My hands.
      audio: {fileID: 0}
