%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Silas v Aegis hub world
  m_EditorClassIdentifier: 
  data:
    convoName: Silas v Aegis hub world
    speakers:
    - Silas
    - Aegis
    lines:
    - character: Silas
      expression: 
      line: "\u2026 and that is precisely how I was able to stem the outbreak of
        diphtheria! Fortunately, it only took two-thirds of the castle\u2019s stores
        of henbane and mandrake. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "Do not forget half of the treasury\u2019s funds. "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "But what is all the world\u2019s gold compared to the value of health? "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: "You know I had to auction off my grandmother\u2019s earring collection
        to replenish the royal coffers, do you not? "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "I, ehm \u2026 was not aware of the particulars of the kingdom\u2019s
        finances. "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'My ministers urged me many times to remove you from office, Silas. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "\u2026 "
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'It was to your advantage that no others could have matched your talents. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'I do my utmost to serve, Majesty. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: 'A set of jewelry is paltry compared to the well-being of my subjects.
        But our best efforts to help those in need may have far-reaching consequences. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: 'Your Majesty has always been conscientious of the entire kingdom. We
        were fortunate to have such a wise king. '
      audio: {fileID: 0}
    - character: King Aegis
      expression: 
      line: Yes, well, we are all trying our best, are we not?
      audio: {fileID: 0}
