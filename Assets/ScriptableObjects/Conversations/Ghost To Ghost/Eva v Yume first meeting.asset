  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Eva v Yume first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: Eva v Yume first meeting
    speakers:
    - Eva
    - Yume
    lines:
    - character: Eva
      expression: 
      line: 'Your outfit is so cute! '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Thank you! I made it myself. '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'REALLY? Do you think you can make one for me? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: "Of course! It\u2019s been so long since I designed clothing! "
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: 'In return, how about I write a song for you? '
      audio: {fileID: 0}
    - character: Yume
      expression: 
      line: 'Actually, can you sing while I sew your outfit? '
      audio: {fileID: 0}
    - character: Eva
      expression: 
      line: Yes? Duh!
      audio: {fileID: 0}
