  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: North v Silas first meeting
  m_EditorClassIdentifier: 
  data:
    convoName: North v Silas first meeting
    speakers:
    - North
    - Silas
    lines:
    - character: North
      expression: 
      line: "So, you\u2019re a plague doctor? "
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "I assure you, my art can remedy any pestilence\u2026 "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: 'By mixing up cures in those little bottles? The only thing a bottle
        cures is bad memories. You think you can save the world? That''s rich. '
      audio: {fileID: 0}
    - character: Silas
      expression: 
      line: "Let\u2019s see you try scrounging up a cure for an ancient dragon's
        blight. "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "\u2026 "
      audio: {fileID: 0}
    - character: North
      expression: 
      line: "Touch\xE9. "
      audio: {fileID: 0}
