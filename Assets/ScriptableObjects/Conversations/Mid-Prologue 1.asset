  m_Script: {fileID: 11500000, guid: 76329f96a0bd36043946dd720240c25c, type: 3}
  m_Name: Mid-Prologue 1
  m_EditorClassIdentifier: 
  data:
    convoName: MidPrologue 1
    speakers:
    - Caladria
    - Shigora
    - Nova Point
    - Oblivion
    lines:
    - character: Caladria
      expression: 
      line: 'Fresh to the throne, the young King Aegis proved a promising leader
        to his people, bringing about an era of peace in his first few years leading
        the kingdom. This peace was short-lived, however, as his untimely deposition
        saw his kingdom thrown into disarray.  '
      audio: {fileID: 0}
    - character: Caladria
      expression: 
      line: In a ploy to reap as many souls as possible with Isovios' power, Orion
        woke an ancient slumbering dragon known as Scathe who tore Caladria apart
        and asperged the land with plague, leaving the kingdom in complete anarchy
        and granting Orion his first taste of immortality.
      audio: {fileID: 0}
